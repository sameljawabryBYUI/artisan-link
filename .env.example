# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps > New OAuth App)
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string of at least 32 characters used to encrypt the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: public URL of the deployed app (e.g. https://artisan-link.vercel.app).
# Leave empty for local development.
APP_URL=
